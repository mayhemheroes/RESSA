# Single-stage Dockerfile for RLENV Patch Playground
# Original image: ghcr.io/mayhemheroes/ressa:master
# Git revision: 58806aee2ab2df5a7d7ec5daf32112e700affc7a

FROM ghcr.io/evanrichter/cargo-fuzz

# Install system dependencies including jq for validation
RUN apt-get update && apt-get install -y jq && rm -rf /var/lib/apt/lists/*

# Install any additional dependencies if needed
# The cargo-fuzz image already contains:
# - Rust nightly toolchain
# - cargo-fuzz
# - LLVM tools
# - Build essentials

# Copy MTV binary for test execution and validation
COPY --from="us-east4-docker.pkg.dev/forallsecure-1/rlenv-staging/rlenv-mcp-static:latest" /rlenv/bin/mtv /rlenv/bin/mtv

# Copy source code to standardized location
COPY . /rlenv/source/ressa

# Set working directory for build
WORKDIR /rlenv/source/ressa/fuzz

# Build the fuzz target in development mode (unoptimized) to trigger stack exhaustion bugs
RUN cargo +nightly fuzz build --dev

# Copy the built fuzz binary to the expected location and make it world-writable
# Note: --dev builds to debug directory instead of release
RUN cp /rlenv/source/ressa/fuzz/target/x86_64-unknown-linux-gnu/debug/ressa-fuzz /ressa-fuzz && \
    chmod 766 /ressa-fuzz

# Copy rlenv directory from build context to /rlenv in the image
COPY rlenv /rlenv

# Make /rlenv/source world-writable so unprivileged users can build
RUN chmod -R 777 /rlenv/source

WORKDIR /
